<header class="sitehead">
  <div class="sitehead-top">
    <a href="{{ pathPrefix or '' }}/" class="brandstack" aria-label="{{ t('common.brand.homeAria') }}">
      <div class="brand">{{ t('common.brand.name') }}</div>
      <div class="sigil">$ = P(1 + r/n)<sup>nt</sup></div>
    </a>

    <div class="sitehead-right">
      <div class="sitehead-search-row">
        <button type="button" id="searchBtn" class="nav-search-btn" aria-label="{{ t('common.search.openAria') }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Zm0-2a5.5 5.5 0 0 0 0-11 5.5 5.5 0 0 0 0 11Z" fill="currentColor" />
            <path d="M16.5 16.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <span class="nav-search-label">{{ t('common.search.button') }}</span>
          <kbd class="nav-search-kbd">⌘K</kbd>
        </button>
      </div>

      <div class="head-actions sitehead-meta">
        <div class="themebox">
          <div class="tlabel" id="theme_label">{{ t('common.theme.dark') }}</div>
          <label class="switch" aria-label="{{ t('common.theme.toggle') }}">
            <input id="theme_toggle" type="checkbox" />
            <span class="knob"></span>
          </label>
        </div>

        <div class="lang-switcher" aria-label="Language">
          <a id="lang-link-en" href="#">English</a><span class="lang-sep" aria-hidden="true"> | </span><a id="lang-link-fr" href="#">Français</a>
        </div>

        <button id="menuBtn" class="menu-btn" aria-expanded="false" aria-controls="menuPanel" aria-label="{{ t('common.nav.openMenu') }}">
          ☰
        </button>
      </div>
    </div>
  </div>
</header>

<div id="menuOverlay" class="menu-overlay"></div>

<nav id="menuPanel" class="menu-panel" aria-label="{{ t('common.nav.menu') }}">
  <div class="menu-top">
    <div class="menu-title">{{ t('common.nav.menu') }}</div>
    <button id="menuClose" class="menu-close" aria-label="{{ t('common.nav.closeMenu') }}">×</button>
  </div>

  <a class="menu-link" href="{{ pathPrefix or '' }}/">{{ t('common.nav.home') }}</a>
  <a class="menu-link" href="{{ pathPrefix or '' }}/about/">{{ t('common.nav.about') }}</a>
  <a class="menu-link" href="{{ pathPrefix or '' }}/contact/">{{ t('common.nav.contact') }}</a>
</nav>
