{% extends "layout.njk" %}
{% block content %}
<section class="card">
  <div class="lede">
    <p>{{ t('meta.home.manifesto1') }}</p>
    <p>{{ t('meta.home.manifesto2') }}</p>
    <p><strong>{{ t('meta.home.manifesto3') }}</strong></p>
  </div>
</section>
<section style="margin-top:16px;">
  <div class="card">
    <div class="section-title">{{ t('meta.home.featuredSectionTitle') }}</div>
    <h1 style="margin:0 0 8px; font-size:20px;">{{ t('meta.home.featuredTitle') }}</h1>
    <p style="margin:0; color:var(--muted); font-size:13px; max-width:820px;">{{ t('meta.home.featuredDesc') }}</p>
    <div style="margin-top:12px;">
      <a href="{{ pathPrefix }}/calculators/advisor-fee/" class="...">{{ t('meta.home.openCalculator') }}</a>
    </div>
    <p style="margin:10px 0 0; color:var(--muted); font-size:12px;">{{ t('meta.home.featuredExample') }}</p>
  </div>
</section>
<section style="margin-top:16px;">
  <div class="home-grid">
    <article class="card" style="position: relative;">
      <a href="{{ pathPrefix }}/articles/investing-and-financial-literacy/" style="display: block; text-decoration: none; color: inherit; position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: 1;" aria-label="{{ t('meta.home.card1Title') }}"></a>
      <h1 style="margin:0 0 8px; font-size:18px;">{{ t('meta.home.card1Title') }}</h1>
      <p style="margin:0; color:var(--muted); font-size:13px;">{{ t('meta.home.card1Desc') }}</p>
      <p style="margin:10px 0 0; color:var(--text); font-size:13px; font-style:italic; font-weight:700;">{{ t('meta.home.card1Tagline') }}</p>
    </article>
    <article class="card" style="position: relative;">
      <a href="{{ pathPrefix }}/essays/" style="display: block; text-decoration: none; color: inherit; position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: 1;" aria-label="{{ t('meta.home.card2Title') }}"></a>
      <h1 style="margin:0 0 8px; font-size:18px;">{{ t('meta.home.card2Title') }}</h1>
      <div class="section-title">{{ t('meta.home.card2ComingSoon') }}</div>
      <p style="margin:0; color:var(--muted); font-size:13px;">{{ t('meta.home.card2Desc') }}</p>
      <p style="margin:10px 0 0; color:var(--text); font-size:13px; font-style:italic; font-weight:700;">{{ t('meta.home.card2Tagline') }}</p>
    </article>
    <article class="card" style="position: relative;">
      <a href="{{ pathPrefix }}/calculators/" style="display: block; text-decoration: none; color: inherit; position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: 1;" aria-label="{{ t('meta.home.card3Title') }}"></a>
      <h1 style="margin:0 0 8px; font-size:18px;">{{ t('meta.home.card3Title') }}</h1>
      <p style="margin:0; color:var(--muted); font-size:13px;">{{ t('meta.home.card3Desc') }}</p>
      <p style="margin:10px 0 0; color:var(--text); font-size:13px; font-style:italic; font-weight:700;">{{ t('meta.home.card3Tagline') }}</p>
    </article>
  </div>
</section>
{% endblock %}
