{% extends "layout.njk" %}
{% block content %}
<a href="{{ localizeRootHref('/calculators/') }}" class="home-link">{{ t('calculators.backToTools') }}</a>
<header>
  <h1>{{ t('calculators.advisorFee.h1') }}</h1>
  <p class="calc-canada-scope">{{ t('calculators.advisorFee.canadaScopeNote') }}</p>
  <div class="lede">
    <p>{{ t('calculators.advisorFee.lede1') }}</p>
    <p>{{ t('calculators.advisorFee.lede2') }}</p>
    <p>{{ t('calculators.advisorFee.lede3') }}</p>
    <p>{{ t('calculators.advisorFee.lede4') }}</p>
    <p>{{ t('calculators.advisorFee.lede5') }} <a href="{{ localizeRootHref('/calculators/flat-fee-or-hourly/') }}" class="inline-link">{{ t('calculators.advisorFee.lede5Link') }}</a>.</p>
    <p><strong>{{ t('calculators.advisorFee.lede6') }}</strong></p>
  </div>
</header>
<div class="calc-grid calc-grid--fee-cost-balanced">
  <section class="card panel panel--inputs">
    <h2 class="section-title">{{ t('calculators.advisorFee.inputs') }}</h2>
    <div class="btns">
      <button id="preset-starting" type="button">{{ t('calculators.advisorFee.presetStarting') }}</button>
      <button id="preset-mid" type="button">{{ t('calculators.advisorFee.presetMid') }}</button>
      <button id="preset-retire" type="button">{{ t('calculators.advisorFee.presetRetire') }}</button>
    </div>
    <p class="hint">{{ t('calculators.advisorFee.presetHint') }}</p>
    <div class="fee-cost-input-fields">
      <div class="fee-cost-field">
        <label for="starting_balance">{{ t('calculators.advisorFee.startingBalance') }}</label>
        <input id="starting_balance" type="number" value="1000000" />
      </div>
      <div class="fee-cost-field">
        <label for="monthly_contribution">{{ t('calculators.advisorFee.monthlyContribution') }}</label>
        <input id="monthly_contribution" type="number" value="5000" />
      </div>
      <div class="fee-cost-field">
        <label for="horizon_years">{{ t('calculators.advisorFee.timeHorizon') }}</label>
        <input id="horizon_years" type="number" value="15" />
      </div>
      <div class="fee-cost-field">
        <label for="annual_return">{{ t('calculators.advisorFee.annualReturn') }}</label>
        <input id="annual_return" type="text" value="7" placeholder="{{ t('calculators.advisorFee.annualReturnPlaceholder') }}" />
      </div>
      <div class="slider-block">
        <div class="slider-top">
          <div class="lbl">{{ t('calculators.advisorFee.annualReturnSlider') }}</div>
          <div class="val" id="annual_return_label">–</div>
        </div>
        <input id="annual_return_slider" type="range" />
      </div>
      <div class="toggle">
        <input id="use_default_fee" type="checkbox" checked />
        <label for="use_default_fee">{{ t('calculators.advisorFee.useDefaultFee') }}</label>
      </div>
      <p class="helper">{{ t('calculators.advisorFee.defaultFeeHelper') }}</p>
      <div class="fee-cost-field">
        <label for="custom_advisor_fee">{{ t('calculators.advisorFee.advisorFeePct') }}</label>
        <input id="custom_advisor_fee" type="text" placeholder="{{ t('calculators.advisorFee.advisorFeePlaceholder') }}" />
      </div>
      <div class="toggle">
        <input id="include_mer" type="checkbox" checked />
        <label for="include_mer">{{ t('calculators.advisorFee.includeMer') }}</label>
      </div>
      <p class="helper">{{ t('calculators.advisorFee.merHelper') }}</p>
      <div class="fee-cost-field">
        <label for="mer_pct">{{ t('calculators.advisorFee.merPct') }}</label>
        <input id="mer_pct" type="text" placeholder="{{ t('calculators.advisorFee.merPlaceholder') }}" />
      </div>
    </div>
  </section>
  <section class="card panel panel--results">
    <div class="results-panel-header">
      <h2 class="section-title">{{ t('calculators.advisorFee.results') }}</h2>
      <a href="{{ localizeRootHref('/calculators/advisor-fee/methodology/') }}" class="inspect-arithmetic-btn" target="_blank" rel="noopener noreferrer">{{ t('calculators.advisorFee.inspectArithmetic') }}</a>
    </div>
    <p id="advisor_calc_engine_error" class="shared-scenario-banner" hidden role="alert" style="border-color:rgba(220,90,90,.45);background:rgba(220,90,90,.1);color:var(--text);"></p>
    <p id="shared_scenario_banner" class="shared-scenario-banner" hidden>{{ t('calculators.advisorFee.sharedScenarioBanner') }}</p>
    <div class="results">
      <div class="result prominent">
        <p class="k">{{ t('calculators.advisorFee.totalCost') }}</p>
        <p class="v" id="out_total_cost">$–</p>
        <p class="subl">{{ t('calculators.advisorFee.totalCostSubl') }}</p>
      </div>
      <section class="result-share-block" aria-labelledby="share-result-heading">
        <h3 id="share-result-heading" class="result-share-title">{{ t('calculators.advisorFee.shareScenarioTitle') }}</h3>
        <p class="result-share-copy">{{ t('calculators.advisorFee.shareScenarioCopy') }}</p>
        <p class="result-share-helper">{{ t('calculators.advisorFee.shareScenarioHelper') }}</p>
        <div class="result-share-actions">
          <button type="button" id="share_result_btn" class="result-share-btn-primary">{{ t('calculators.advisorFee.btnShareScenario') }}</button>
          <button type="button" id="download_result_btn">{{ t('calculators.advisorFee.btnSaveCalculation') }}</button>
          <button type="button" id="copy_result_link_btn">{{ t('calculators.advisorFee.btnCopyShareableLink') }}</button>
        </div>
        <p class="result-share-status" id="result_share_status" aria-live="polite"></p>
      </section>
      <div class="result">
        <p class="k">{{ t('calculators.advisorFee.breakeven') }}</p>
        <p class="v" id="out_breakeven">–</p>
      </div>
      <div class="result">
        <p class="k">{{ t('calculators.advisorFee.endingWith') }}</p>
        <p class="v" id="out_with">$–</p>
      </div>
      <div class="result">
        <p class="k">{{ t('calculators.advisorFee.endingWithout') }}</p>
        <p class="v" id="out_without">$–</p>
      </div>
      <div class="result">
        <p class="k">{{ t('calculators.advisorFee.feesPaid') }}</p>
        <p class="v" id="out_fees">$–</p>
      </div>
      <div class="result">
        <p class="k">{{ t('calculators.advisorFee.lostCompounding') }}</p>
        <p class="v" id="out_lost">$–</p>
      </div>
    </div>
  </section>
</div>
<div class="report-issue-wrap">
  <a href="{{ localizeRootHref('/contact/') }}" class="report-issue-link">{{ t('common.links.reportIssue') }}</a>
</div>
<section class="methods" id="methods">
  <div class="methods-card">
    <h2>{{ t('calculators.advisorFee.methodTitle') }}</h2>
    <div class="default-fee">
      <div>
        <h3>{{ t('calculators.advisorFee.defaultFeeModel') }}</h3>
        <p>{{ t('calculators.advisorFee.defaultFeeDesc') }}</p>
        <p class="default-note">{{ t('calculators.advisorFee.defaultFeeNote') }}</p>
      </div>
      <div>
        <table class="fee-table">
          <thead>
            <tr>
              <th>{{ t('calculators.advisorFee.feeTableAssets') }}</th>
              <th>{{ t('calculators.advisorFee.feeTableRate') }}</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>$0 – $250,000</td><td>2.00%</td></tr>
            <tr><td>$250,000 – $500,000</td><td>1.75%</td></tr>
            <tr><td>$500,000 – $1,000,000</td><td>1.50%</td></tr>
            <tr><td>$1,000,000 – $2,000,000</td><td>1.25%</td></tr>
            <tr><td>Over $2,000,000</td><td>1.00%</td></tr>
          </tbody>
        </table>
      </div>
    </div>
    <div class="method-list">
      <div class="method-item">
        <strong>{{ t('calculators.advisorFee.methodAdvisorOverride') }}</strong>
        <div>{{ t('calculators.advisorFee.methodAdvisorOverrideDesc') }}</div>
      </div>
      <div class="method-item">
        <strong>{{ t('calculators.advisorFee.methodMer') }}</strong>
        <div>
          <span>{{ t('calculators.advisorFee.methodMerDesc') }}</span><br><br>
          <span>{{ t('calculators.advisorFee.methodMerDesc2') }}</span><br><br>
          <span>{{ t('calculators.advisorFee.methodMerDesc3') }}</span><br><br>
          <span class="inline-note"><strong>{{ t('calculators.advisorFee.methodMerNote') }}</strong></span>
        </div>
      </div>
      <div class="method-item">
        <strong>{{ t('calculators.advisorFee.methodFeesPaid') }}</strong>
        <div>{{ t('calculators.advisorFee.methodFeesPaidDesc') }}</div>
      </div>
      <div class="method-item">
        <strong>{{ t('calculators.advisorFee.methodLostCompounding') }}</strong>
        <div>{{ t('calculators.advisorFee.methodLostCompoundingDesc') }}</div>
      </div>
      <div class="method-item">
        <strong>{{ t('calculators.advisorFee.methodTotalCost') }}</strong>
        <div>{{ t('calculators.advisorFee.methodTotalCostDesc') }}</div>
      </div>
      <div class="method-item">
        <strong>{{ t('calculators.advisorFee.methodBreakeven') }}</strong>
        <div>
          <span>{{ t('calculators.advisorFee.methodBreakevenDesc') }}</span><br><br>
          <strong>{{ t('calculators.advisorFee.methodBreakevenExampleLabel') }}</strong>
          <span>{{ t('calculators.advisorFee.methodBreakevenExample') }}</span>
        </div>
      </div>
      <div class="method-item">
        <strong>{{ t('calculators.advisorFee.methodScope') }}</strong>
        <div>{{ t('calculators.advisorFee.methodScopeDesc') }}</div>
      </div>
    </div>
  </div>
</section>
<div class="disclaimer">
  <p>{{ t('calculators.advisorFee.disclaimer') }}</p>
</div>
{% endblock %}
{% block footScripts %}
<script defer src="/assets/js/calculator.engine.js"></script>
<script defer src="/assets/js/calculator.ui.js"></script>
<script src="/assets/js/theme.js"></script>
{% endblock %}
